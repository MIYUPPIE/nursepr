# Copy to .env (gitignored) and fill in real values when available.
# Nothing here is required for local dev-OtpSender.Log and Req.Test stubs
# cover auth/WhatsApp/Paystack/Anthropic locally without any of these set.

# Evolution API (WhatsApp)
EVOLUTION_API_BASE_URL=
EVOLUTION_API_INSTANCE=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_TOKEN=

# Telegram (fallback channel-see evolution/README.md's sibling notes and
# the root README's "Telegram Bot API" section). No self-hosted gateway
# needed, just a bot token from @BotFather and a webhook secret you
# generate yourself.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# xAI / Grok (AI tutor)
X_API_KEY=
XAI_MODEL=grok-4

# Email OTP delivery (for students without WhatsApp). Any SMTP provider
# works-Gmail, Amazon SES, Mailgun, Postmark, Resend, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_FROM_EMAIL=no-reply@nurseprep.ng
